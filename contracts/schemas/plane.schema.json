{
  "$defs": {
    "Extent2": {
      "additionalProperties": false,
      "description": "A size or centre on a plane, in plane-local metres (x and z; the plane normal is +y).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "title": "Extent2",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "description": "A headset or plane pose in the WebXR local-floor frame: metres, Y up, right-handed.",
      "properties": {
        "frame": {
          "const": "local-floor",
          "default": "local-floor",
          "title": "Frame",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "quaternion": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "position",
        "quaternion"
      ],
      "title": "Pose",
      "type": "object"
    },
    "Quaternion": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vec3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "orientation": {
      "anyOf": [
        {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orientation"
    },
    "pose": {
      "$ref": "#/$defs/Pose"
    },
    "center": {
      "$ref": "#/$defs/Extent2"
    },
    "size": {
      "$ref": "#/$defs/Extent2"
    }
  },
  "required": [
    "id",
    "label",
    "pose",
    "center",
    "size"
  ],
  "title": "Plane",
  "type": "object"
}

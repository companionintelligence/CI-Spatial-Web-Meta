# Copy to .env.local for local overrides (gitignored). All of these are
# optional — the app works with none of them set (same-origin /v1, no auth),
# which is the right default for the Vite dev server + local cv-server.
# See "Connecting to a server" in ../README.md.

# Default server base URL baked into the build. Leave unset for same-origin
# (the Vite dev proxy locally, or whatever origin the built app is served
# from in production). Overridden at runtime by the in-app "Server" field or
# a one-time ?server=https://host link — this is only the fallback.
VITE_DEFAULT_SERVER_URL=

# Sign-in with Companion Intelligence has no build settings. The CI Portal and
# the app's public client are the Worker's CI_PORTAL_URL and CI_OAUTH_CLIENT_ID
# (the [vars] block in wrangler.toml). Serve them locally with `npm run dev:worker`
# next to `npm run dev`. See docs/integration/ci-platform.md in the repo root.
